<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- Steam depots may advertise HTTP CDN endpoints; authentication stays HTTPS/WSS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">steamcontent.com</domain>
    </domain-config>
</network-security-config>
