static std::string choicePart(const std::string& s){auto at=s.find("\"choice\":");check(at!=std::string::npos,"choice snapshot field");auto end=s.find(",\"screenWave\":",at);return s.substr(at+9,end-at-9);}
static std::string choiceRevision(const std::string&s){auto part=choicePart(s);auto at=part.find("\"revision\":\"");check(at!=std::string::npos,"pending choice revision");at+=12;return part.substr(at,part.find('"',at)-at);}
static void choiceAppend(Program&p,int value,const std::string& label){p.string(label);p.push(value);p.op(0x160);}
static void choiceOpen(Program&p,int opcode=0x161,int arg2=2){for(int n:{0,arg2,0,2})p.push(n);p.op(opcode);}
static void choiceZ(Program&p,int value){p.push(value);p.push(0);p.op(0x251);}
static void choiceBranch(Program&p,bool invalid=false){std::array<size_t,19> patch;patch.fill(SIZE_MAX);for(int i=18;i>=0;--i){if(i==3||i==9||i==11){p.op(1);patch[size_t(i)]=p.words.size();p.op(0);}else p.push(-1);}p.push(0);p.push(2);p.op(0x162);choiceZ(p,77);p.dialogue(0);p.op(0xf4);for(int i:{3,9,11}){p.words[patch[size_t(i)]]=uint32_t(p.words.size()*4);if(invalid&&i==3){p.words[patch[size_t(i)]-1]=0;p.words[patch[size_t(i)]]=UINT32_MAX;}choiceZ(p,i*111);p.dialogue(0);p.op(0xf4);}}
